# Environment variable overrides for facter-oss
# Convention: dots replaced by underscores, uppercased.
# Example: facter.sink.output.type → FACTER_SINK_OUTPUT_TYPE

# Output mode
FACTER_SINK_OUTPUT_TYPE=file
FACTER_SINK_OUTPUT_OUTPUTDIRECTORY=/tmp
FACTER_SINK_OUTPUT_OUTPUTFILENAME=export.iya

# Remote gRPC server (when FACTER_SINK_OUTPUT_TYPE=remote)
FACTER_SINK_OUTPUT_FACTERSERVER_SERVERHOST=localhost
FACTER_SINK_OUTPUT_FACTERSERVER_SERVERPORT=56230
FACTER_SINK_OUTPUT_FACTERSERVER_CAPATH=
FACTER_SINK_OUTPUT_FACTERSERVER_CERTIFICATEPATH=
FACTER_SINK_OUTPUT_FACTERSERVER_CERTIFICATEKEYPATH=
FACTER_SINK_OUTPUT_FACTERSERVER_SSLHOSTNAME=
FACTER_SINK_OUTPUT_FACTERSERVER_INSECURESKIPTLSVERIFY=false

# Store
FACTER_STORE_PATH=/tmp/facter-store.db

# Logs
FACTER_LOGS_DEBUGMODE=false
